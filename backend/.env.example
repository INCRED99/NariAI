# MongoDB Configuration
# For production (Render), use MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=nari

# AI API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Authentication
FIREBASE_API_KEY=your_firebase_web_api_key_here
# On Render: paste the entire contents of serviceaccount.json as a single-line JSON or base64 encoded string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# CORS Configuration
# Comma-separated list of allowed origins, or * for open access.
# Example: https://nari-ai-sandy.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# SMS / Alert Services (Optional - defaults to 'mock')
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
CALLMEBOT_KEYS=
